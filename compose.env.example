# Copy to .env in this directory (gitignored), then edit. docker-compose.yml reads it automatically.
#
#   cp compose.env.example .env
#
# NOT named .env.docker.example on purpose: the root .gitignore ignores `.env.*` with only
# `!.env.example` re-included, so any name starting with ".env." would be untracked and invisible
# to anyone cloning the repo.
#
# WARNING: this is a LOCAL stack. Do not paste the contents of backend/backlog/.env here — that
# file points at live Neon, and this stack runs Flyway and seeds admin accounts on boot.

# --- database (local container; these three just have to agree with each other) ---
DB_NAME=backlog
DB_USER=backlog
DB_PASSWORD=backlog

# --- required ---
# 32 bytes minimum or the app fails fast at startup. Generate one:
#   openssl rand -base64 48
JWT_SECRET=

# --- first-boot admin seeding ---
# Set at least ONE to be able to sign in. An unset value means that account is not created, so
# there is no guessable default. Seeded accounts must change their password at first login.
# Only ADMIN and PRINCIPAL are seedable; HOD / DEPT_OFFICE / PROCTOR need a department and are
# created through Manage Users.
ADMIN_PASSWORD_ADMIN=
ADMIN_PASSWORD_PRINCIPAL=
