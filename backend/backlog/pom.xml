<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.college</groupId>
	<artifactId>backlog</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backlog</name>
	<description>Backlog Management System</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<!-- Ahead of Boot 3.5.16's managed Flyway 11.7.2, whose Postgres module tops out at
		     PG 17 and logs "Flyway upgrade recommended" against our PG 18 (Neon and the local
		     test container both run 18.4). 11.13.3 is the first release that certifies PG 18.
		     Overriding the property (not the two artifacts) keeps flyway-core and
		     flyway-database-postgresql in lockstep. -->
		<flyway.version>11.13.3</flyway.version>
		<!-- Last of the 7.2.x line. 7.2.6 is what moves BouncyCastle onto the maintained
		     bc*-jdk18on artifacts (1.75); 7.2.5 was still on bc*-jdk15on 1.70, retired since 2022.
		     Staying on 7.2.x deliberately — 8.x/9.x are major versions and PdfService has only the
		     one test guarding it. -->
		<itext.version>7.2.6</itext.version>
		<!-- Ahead of Boot 3.5.16's managed 42.7.11, which carries CVE-2026-54291
		     (GHSA-j92g-9f8w-j867): a SILENT channel-binding downgrade when the server does not
		     support it. Directly relevant here — DB_URL sets channelBinding=require precisely to
		     demand it, and the CVE lets that requirement be dropped without error. Fixed in
		     42.7.12. Found 2026-08-26 by scanning the resolved runtime tree against OSV.dev. -->
		<postgresql.version>42.7.12</postgresql.version>
		<!-- iText 7.2.6 pulls BouncyCastle 1.75, which carries NINE advisories; 1.84 clears all of
		     them. Overridden here rather than by moving iText, since 8.x/9.x are major versions and
		     PdfService has only the one test guarding it (see itext.version above).
		     NOT reachable in this app — the "signature row" on the form is a drawn line for a human
		     to sign, not a cryptographic PdfSigner, and nothing here parses untrusted certificates.
		     Bumped anyway: 1.75 is from 2023, the override is free, and reachability is a judgement
		     that could quietly stop being true. -->
		<bouncycastle.version>1.84</bouncycastle.version>
		<!-- The three below are all Boot-managed and were all UNREACHABLE here (jackson's advisories
		     need @JsonView/@JsonUnwrapped, which this app never uses; netty's is Bzip2Decoder;
		     log4j-api's is MapMessage encoding, and we log through logback via log4j-to-slf4j).
		     Bumped anyway because each is a patch/minor within the same line, i.e. nearly free —
		     and "unreachable" is a judgement that stops being true the moment someone adds an
		     annotation. Drop these overrides once a Boot 3.5.x patch carries the same versions. -->
		<jackson-bom.version>2.21.5</jackson-bom.version>
		<netty.version>4.1.136.Final</netty.version>
		<log4j2.version>2.25.5</log4j2.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<!-- Boot's BOM does not manage BouncyCastle, so the <bouncycastle.version> property
			     alone is INERT — verified 2026-08-26, the tree still resolved iText's 1.75. These
			     three entries are what actually pin it. bcutil is listed because bcpkix depends on
			     it and a version skew across the trio is its own failure mode. -->
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<!-- Flyway: versioned schema migrations. flyway-database-postgresql is required
		     for Postgres on Flyway 10+ (DB support was split into modules). -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<!-- Redis: backs the PDF rate limiter ONLY (PdfRateLimitInterceptor). Deliberately not
		     session state — auth is a stateless JWT and SecurityConfig is SessionCreationPolicy
		     .STATELESS. Lettuce connects lazily, so an unset REDIS_URL costs nothing at boot and
		     the limiter simply stays off (app.ratelimit.enabled). -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- PDF generation (PdfService is the only consumer). We declare the three modules it
		     actually imports instead of the itext7-core aggregate pom, which dragged in seven
		     unused ones (barcodes, font-asian, forms, hyph, pdfa, sign, styled-xml-parser, svg).
		     kernel still pulls BouncyCastle transitively — 7.2.6 moved that from the retired
		     bc*-jdk15on 1.70 line to the maintained bc*-jdk18on 1.75, which is the reason for the
		     bump. Covered by PdfServiceTest, which asserts on extracted text so a version change
		     is verifiable. -->
		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>kernel</artifactId>
			<version>${itext.version}</version>
		</dependency>

		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>layout</artifactId>
			<version>${itext.version}</version>
		</dependency>

		<dependency>
			<groupId>com.itextpdf</groupId>
			<artifactId>io</artifactId>
			<version>${itext.version}</version>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<parameters>true</parameters>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
