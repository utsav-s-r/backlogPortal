DB_URL=jdbc:postgresql://username:password@localhost:5432/database_name_or_online
DB_USER=neondb_owner
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_POOL_MAX_SIZE=5
# Leave at 0 against Neon. An idle pooled connection counts as activity, defeats the 5-min
# autosuspend, and bills compute 24/7 (~186 CU-h/month vs a 100 CU-h/project free allowance).
DB_POOL_MIN_IDLE=0
# Below Neon's 5-min autosuspend timer; Hikari's own default is 10 min, which is too long.
DB_POOL_IDLE_TIMEOUT_MS=30000
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=SET_A_LONG_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=3600000

# Initial admin-account seed password. NO built-in default: an unset var means the account is
# NOT created on a fresh database, so there is no guessable fallback. Set it on first boot, then
# leave it unset — a value left here keeps a live credential on the host. ADMIN is the ONLY
# seedable role; it creates every other one (PRINCIPAL included) through Manage Users, and
# HOD/DEPT_OFFICE/PROCTOR additionally need a department a seeder cannot assign.
# ADMIN_PASSWORD_ADMIN=

# Boot behavior. The defaults in application.properties are dev-friendly, so leave these unset
# locally; in PRODUCTION set them to harden the boot:
#   JPA_DDL_AUTO=validate   # verify schema only, never auto-migrate (add Neon columns manually first)
#   SQL_INIT_MODE=never     # skip schema.sql/data.sql demo seeding
# Optional local debugging:
#   JPA_SHOW_SQL=true       # log every SQL statement (off by default)
