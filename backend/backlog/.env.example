DB_URL=jdbc:postgresql://username:password@localhost:5432/database_name_or_online
DB_USER=neondb_owner
DB_PASSWORD=YOUR_PASSWORD_HERE
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=SET_A_LONG_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MS=3600000

# Initial admin-account seed passwords. NO built-in defaults: an unset var means that account is
# NOT created on a fresh database, so there is no guessable fallback. Set the ones you need on
# first boot (seeded accounts must change the password on first login), then leave unset. Only
# ADMIN and PRINCIPAL are seedable — HOD/DEPT_OFFICE/PROCTOR need a department, so create those
# through Manage Users.
# ADMIN_PASSWORD_PRINCIPAL=
# ADMIN_PASSWORD_ADMIN=

# Boot behavior. The defaults in application.properties are dev-friendly, so leave these unset
# locally; in PRODUCTION set them to harden the boot:
#   JPA_DDL_AUTO=validate   # verify schema only, never auto-migrate (add Neon columns manually first)
#   SQL_INIT_MODE=never     # skip schema.sql/data.sql demo seeding
# Optional local debugging:
#   JPA_SHOW_SQL=true       # log every SQL statement (off by default)
