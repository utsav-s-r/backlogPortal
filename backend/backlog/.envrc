# Pin this project to JDK 21 (matches pom.xml java.version / Spring Boot 3.5.x).
# Resolves whatever JDK 21 is installed on this Mac — no hardcoded path.
# Requires direnv (https://direnv.net). Run `direnv allow` once after cloning.
export JAVA_HOME="$(/usr/libexec/java_home -v 21)"
export PATH="$JAVA_HOME/bin:$PATH"
