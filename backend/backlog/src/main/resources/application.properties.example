# Copy to application.properties (gitignored). Secrets and config come from .env, loaded via the
# spring.config.import line below; the defaults here are safe fallbacks only.
spring.config.import=optional:file:.env[.properties]

spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/database_name}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:YOUR_PASSWORD_HERE}
spring.datasource.hikari.maximum-pool-size=${DB_POOL_MAX_SIZE:5}
spring.datasource.hikari.minimum-idle=${DB_POOL_MIN_IDLE:1}
# Serverless Postgres (Neon) auto-suspends when idle and takes a second or two to wake. Hikari's
# own default is already 30s; stated explicitly so it is tunable per environment.
spring.datasource.hikari.connection-timeout=${DB_CONNECTION_TIMEOUT_MS:30000}
# FLYWAY is what actually hits a sleeping database first — it migrates at boot, before Hikari
# serves anything, so Hikari timeouts alone do NOT stop a cold start from dying on a suspended
# Neon. Retries default to 0 (Flyway's own default) so LOCAL behaviour is unchanged: a genuinely
# stopped test container still fails immediately instead of hanging for 20s, which is the
# "ApplicationContext failure threshold -> check Docker first" path. Set FLYWAY_CONNECT_RETRIES
# on a deployed host (10 is reasonable) so a wake-up is ridden out rather than crashing the boot.
spring.flyway.connect-retries=${FLYWAY_CONNECT_RETRIES:0}
spring.flyway.connect-retries-interval=${FLYWAY_CONNECT_RETRIES_INTERVAL:2}

# Boot behavior. Flyway owns the schema (src/main/resources/db/migration); Hibernate only
# VALIDATES it, never mutates. Leave these at the defaults.
#   JPA_DDL_AUTO=validate  -> assert entities match the DB, never auto-migrate
#   JPA_SHOW_SQL=true      -> log every SQL statement (debugging only; off by default)
#   SQL_INIT_MODE=never    -> schema.sql/data.sql are retired; Flyway builds the schema
spring.jpa.hibernate.ddl-auto=${JPA_DDL_AUTO:validate}
spring.jpa.show-sql=${JPA_SHOW_SQL:false}
spring.jpa.properties.hibernate.format_sql=${JPA_FORMAT_SQL:false}
# No hibernate.dialect on purpose: Hibernate 6 resolves it from JDBC metadata and warns
# (HHH90000025) if set. Auto-detection also reads the server version, where a hardcoded
# PostgreSQLDialect would pin us to the base dialect. Don't re-add it.
# OFF deliberately: read paths fetch-join what they need or map inside a transaction, so no query
# should run during response rendering.
#   JPA_OPEN_IN_VIEW=true  -> emergency escape hatch only; setting it means a fetch regressed
spring.jpa.open-in-view=${JPA_OPEN_IN_VIEW:false}
spring.sql.init.mode=${SQL_INIT_MODE:never}

# Flyway: baseline an already-populated DB at V1; a fresh empty one runs V1 to build the schema.
# New schema changes go in db/migration as the next V<n>__*.sql.
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=1

app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174}
# NO fallback value on purpose. The old default was a 40-byte placeholder, which passed
# JwtService's 32-byte floor — so an unset JWT_SECRET booted green on a signing key published in
# this repo. Empty means the blank check fails the boot instead. JwtService ALSO rejects the old
# placeholder by value, which is what covers the gitignored application.properties files already
# generated from this template.
app.jwt.secret=${JWT_SECRET:}
# Hard session length for everyone, student and admin: 1h from login, non-renewable (there is no
# refresh endpoint). Past it every request is anonymous -> 401 -> the SPA signs the user out.
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}
# Session cookie Secure flag. MUST stay true in production (https); false ONLY for local http dev,
# else the browser drops the httpOnly session cookie.
app.cookie.secure=${APP_COOKIE_SECURE:true}
# Session cookie SameSite: Lax | Strict | None (any casing). VALIDATED AT BOOT — anything else, or
# None without app.cookie.secure=true, fails the app fast instead of silently shipping a downgraded
# cookie policy. LEAVE AT Lax unless the SPA and API end up on different registrable domains; this
# is settable so it needs no rebuild, not because it should be changed. Strict logs students out on
# inbound links from email/the college site for no real CSRF gain (the double-submit token already
# covers cross-site POST). None stays available on purpose for a future cross-origin deployment.
app.cookie.same-site=${APP_COOKIE_SAME_SITE:Lax}

# PDF rate limiting (PdfRateLimitService). OFF by default so local runs and tests need no Redis.
# Set RATELIMIT_ENABLED=true and REDIS_URL on a deployed host to switch it on.
# Limits the two iText endpoints ONLY — /api/admin/export-pdf and the student registration PDF.
# LOGIN IS DELIBERATELY NOT LIMITED and no login path may ever return 429: throttling there is a
# declined feature, see docs/adr/student-authentication.md. Do not add login paths here.
app.ratelimit.enabled=${RATELIMIT_ENABLED:false}
app.ratelimit.pdf.max-per-window=${RATELIMIT_PDF_MAX:10}
app.ratelimit.pdf.window-minutes=${RATELIMIT_PDF_WINDOW_MINUTES:60}
# Redis connection is set ONLY as an environment variable on the deployed host:
#     SPRING_DATA_REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# (Upstash TCP tab. `rediss://` — two s — is TLS. The REST tab's URL+TOKEN are an HTTP API and are
# NOT usable here; Spring Data Redis speaks the RESP protocol over TCP.)
#
# There is deliberately NO `spring.data.redis.url=` line: Spring VALIDATES the URL eagerly at
# startup and an empty string throws `RedisUrlSyntaxException: Invalid Redis URL ''`, which kills
# the whole context (it broke all 22 context tests when first added). With the property absent,
# Redis auto-config falls back to localhost, Lettuce connects lazily, and PdfRateLimitService's
# fail-open path handles the unreachable connection — so local runs and tests need no Redis at all.
# Nothing else uses Redis, so scanning JPA repositories as Redis repositories is pure noise:
spring.data.redis.repositories.enabled=false

# Initial admin-account seed passwords, set via env. No fallback default: a blank value means the
# account is NOT created on a fresh DB, so there is nothing guessable. Only ADMIN and PRINCIPAL are
# seedable — HOD/DEPT_OFFICE/PROCTOR need a department, so create those via Manage Users.
admin.password.principal=${ADMIN_PASSWORD_PRINCIPAL:}
admin.password.admin=${ADMIN_PASSWORD_ADMIN:}

spring.application.name=backlog
# ${PORT:8080} so a hosting platform that assigns a port at runtime (Render, Cloud Run, Heroku and
# most PaaS set PORT) is obeyed, while local runs and docker-compose keep 8080 unchanged.
server.port=${PORT:8080}
server.error.include-message=never

# Gzip API responses; Boot's default mime-type list already covers application/json. Registration
# and subject list payloads compress ~5-10x. PDFs are already compressed and stay untouched, since
# application/pdf isn't listed.
server.compression.enabled=true
server.compression.min-response-size=1024
